{
  "$schema": "https://raw.githubusercontent.com/t8y2/dbx/plugin-sdk-v1/plugins/manifest.schema.json",
  "manifest_version": 1,
  "id": "io.github.aili0617.toolbox",
  "name": "工具箱",
  "version": "0.1.0",
  "publisher": "aili0617",
  "description": "JSON 等常用开发小工具集合。",
  "icon": "assets/plugin.svg",
  "source": "https://github.com/aiLi0617/dbx-plugin-toolbox",
  "homepage": "https://github.com/aiLi0617/dbx-plugin-toolbox",
  "engines": {
    "dbx": ">=0.5.68",
    "host_api": "1"
  },
  "entrypoints": {
    "backend": {
      "executable": "bin/dbx-plugin-toolbox"
    },
    "ui": {
      "root": "ui",
      "entry": "ui/index.html"
    }
  },
  "contributions": [
    {
      "type": "connection-provider",
      "id": "io.github.aili0617.toolbox.connection",
      "label": "工具箱 connection",
      "icon": "assets/plugin.svg",
      "database_type": "dbx-plugin-toolbox",
      "description": "Connection form contributed by 工具箱.",
      "fields": [
        {
          "key": "display_name",
          "label": "Connection name",
          "type": "text",
          "default": "工具箱 connection",
          "binding": "name",
          "required": true
        },
        {
          "key": "host",
          "label": "Host",
          "type": "text",
          "default": "localhost",
          "binding": "host",
          "required": true
        },
        {
          "key": "port",
          "label": "Port",
          "type": "number",
          "default": 0,
          "binding": "port",
          "required": true
        }
      ],
      "workbench": "io.github.aili0617.toolbox.workbench",
      "capabilities": ["test", "connect", "disconnect"]
    },
    {
      "type": "workbench",
      "id": "io.github.aili0617.toolbox.workbench",
      "label": "工具箱 Workbench",
      "description": "Sandboxed UI contributed by 工具箱.",
      "icon": "assets/plugin.svg"
    }
  ],
  "localizations": {
    "zh-CN": {
      "name": "工具箱",
      "description": "JSON 等常用开发小工具集合。",
      "contributions": {
        "io.github.aili0617.toolbox.connection": {
          "label": "工具箱 连接",
          "description": "由插件声明的连接表单。",
          "fields": {
            "display_name": { "label": "连接名称" },
            "host": { "label": "主机" },
            "port": { "label": "端口" }
          }
        },
        "io.github.aili0617.toolbox.workbench": {
          "label": "工具箱 工作台",
          "description": "由插件提供的沙箱工作台界面。"
        }
      }
    }
  }
}
